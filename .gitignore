# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Supabase Edge Functions Secrets (local `supabase functions serve` reads
# these -- e.g. ORS_API_KEY). Also caught by the `.env` rule below, but kept
# explicit so it doesn't silently depend on that rule staying unanchored.
supabase/.env
supabase/functions/.env

# Secret Environment Variables
.env

# Personal Claude Code permission overrides (not shared with the team)
.claude/settings.local.json

# Firebase local cache (deploy history, hosting cache -- not config, safe to ignore)
.firebase/
# Codebase snapshot dumps — these have embedded credentials before now
AI_SNAPSHOT.txt
*_SNAPSHOT.txt
*.bundle

# Supabase CLI local state (version cache, linked-branch info) -- machine-specific
supabase/.temp/
supabase/.branches/

# Local developer tooling -- not part of the project
.claude/
skills-lock.json
